#!/bin/sh
# Thin AppImage entry: official OpenAI Electron binary, host libraries.
set -e

self=$(readlink -f "$0")
HERE=${self%/*}
export APPDIR="${APPDIR:-$HERE}"

# Do not set LD_LIBRARY_PATH. Host Mesa / GTK / NSS must be used as-is;
# Electron finds its own $ORIGIN libs (libffmpeg, SwiftShader, …) via RPATH.
# The official .deb has no chrome-sandbox; Chromium uses user namespaces.
# If a host blocks userns, pass --no-sandbox on the command line.

# The AppImage runtime sets ARGV0 to the AppImage path; Electron treats argv[0]
# as the helper name if we leave that in place.
unset ARGV0

cd "${APPDIR}/usr/lib/chatgpt"
exec "${APPDIR}/usr/lib/chatgpt/ChatGPT" "$@"
